# Copy this file to backend/.env and fill it in. Never commit .env.

# --- Database --------------------------------------------------------------
# Local PostgreSQL (the URL pgAdmin connects to). Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# On Neon, add ?sslmode=require at the end.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/missingpiece
# A separate, EMPTY database for pytest. Tests drop every table in it.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/missingpiece_test

# --- Supabase Auth (identity only) -----------------------------------------
# Project Settings > API (or "Data API") in the Supabase dashboard.
SUPABASE_URL=
# Fill ONE of these, depending on how your project signs tokens:
#   JWT secret (legacy, HS256):   Project Settings > JWT Keys > Legacy JWT secret
#   Signing keys (ES256/RS256):   leave both empty; SUPABASE_URL is enough
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# Service role key: storage uploads and the seed script only. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=registration-documents

# --- Development only --------------------------------------------------------
# true = also accept test tokens signed with DEV_JWT_SECRET (before Supabase is ready, and for tests).
DEV_AUTH=true
DEV_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- AI matching (optional) ----------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Payments ----------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me
PLATFORM_COMMISSION_RATE=0.05

# --- Email (approval and rejection notices) ----------------------------------
# Leave empty to only write emails to the server log. For Gmail use an App password
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MissingPiece

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JOBS_SECRET=change-me
